{
  "name": "github-dashboard",
  "version": "0.1.0",
  "description": "A local pull-request work queue and inspector for GitHub.",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint src next.config.ts",
    "format": "oxfmt src next.config.ts tailwind.config.ts",
    "format:check": "oxfmt --check src next.config.ts tailwind.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "^1.0.0-beta.6",
    "lucide-react": "^1.16.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
