# Optional: omit this to use `gh auth token`.
# GITHUB_TOKEN=github_pat_xxx

# Optional search overrides. Separate multiple complete queries with `|`.
# GITHUB_SEARCH_QUERY=author:@me is:pr is:open sort:updated-desc
# GITHUB_REVIEWS_SEARCH_QUERY=is:pr is:open -author:@me user-review-requested:@me sort:updated-desc | is:pr is:open -author:@me reviewed-by:@me sort:updated-desc

# Optional GraphQL and pagination overrides.
# GITHUB_GRAPHQL_ENDPOINT=https://api.github.com/graphql
# GITHUB_PAGE_SIZE=10

# Verify GitHub's X-Hub-Signature-256 when using the optional webhook endpoint.
# GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# Optional bearer token protecting local mutation routes (/api/prs/*, /api/threads/*, /api/refresh).
# When unset, localhost use needs no extra header. When set, send Authorization: Bearer <token>.
# DASHBOARD_API_TOKEN=replace-with-a-random-token

# Optional identity for recognizing your own raw commit events in unread activity.
# GITHUB_USER_NAME=Your Name
# GITHUB_USER_EMAIL=you@example.com
